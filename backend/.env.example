# Database Configuration
# Use DATABASE_URL for all environments (recommended)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/fortunetiles_db
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/fortunetiles_test

# JWT Secret (generate a secure random string - minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_here

# Email Configuration (for password reset)
# Use Gmail app-specific password, not your main password
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here
FRONTEND_URL=http://localhost:3000

# GitHub Webhook Configuration (for automatic website updates)
# Generate a secure random string for webhook verification
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Server Configuration
PORT=5000
NODE_ENV=development

# Admin User Seeding (development only)
# Set to 'true' to auto-create admin user on startup
SEED_ADMIN_USER=false
ADMIN_PASSWORD=ChangeMe123!

# Security Configuration
# Set to 'true' in production to enforce HTTPS
ENFORCE_HTTPS=false

# Application URL (for production)
APP_PUBLIC_URL=https://yourdomain.com
