# Dockerfile for truthful-balance project deployment
# This is a self-contained backend deployment

FROM node:20-alpine

WORKDIR /app

# Copy entire project
COPY . .

# Navigate to backend and install dependencies
WORKDIR /app/backend
RUN npm ci --only=production

# Install sequelize-cli globally
RUN npm install -g sequelize-cli

# Copy startup script to app root
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Create necessary directories
RUN mkdir -p /app/public /app/website-build

# Set working directory back to app root
WORKDIR /app

# Environment variables
ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

# Run from app root with backend as working directory
CMD ["sh", "-c", "cd /app/backend && node server.js"]
