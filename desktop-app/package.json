{
  "name": "fortune-tiles-desktop",
  "version": "2.0.0",
  "description": "Fortune Tiles - offline desktop inventory system",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish=never",
    "dist": "npm run build"
  },
  "author": "Fortune Tiles",
  "license": "MIT",
  "dependencies": {
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "usb": "^2.14.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.fortunetiles.inventory",
    "productName": "Fortune Tiles",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "printer/**/*",
      "printer-test.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!data/**",
          "!**/*.log",
          "!tools/**"
        ]
      }
    ],
    "asarUnpack": [
      "backend/node_modules/**"
    ],
    "afterPack": "./afterPack.js",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FortuneTiles-${version}-portable.exe",
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "forceCodeSigning": false,
    "npmRebuild": false
  }
}
